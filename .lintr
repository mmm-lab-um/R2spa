# lintr configuration for R2spa.
# Object names are exempt: the codebase intentionally uses short math-style
# names (fsT, fsL, S_eta, ...) and documented CamelCase backward-compat
# aliases, and the public API includes camelCase arguments (vfsLT).
# Line length 100 matches the codebase convention (no existing R/ line is
# longer than 100 characters).
linters: linters_with_defaults(object_name_linter = NULL, line_length_linter = line_length_linter(100L))
exclusions: list("legacy", "archive")
